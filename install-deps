#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
# install-deps - install OS packages required by active system packages
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# Its own model: state/model.json holds the last build's prefix, which ./install deploys.
MODEL=state/deps-model.json
python3 scripts/config.py -root . \
    -solution config/sonicde/solutions/sonicde.yaml \
    -out "$MODEL" \
    "$@"

# Print platform packages for the current distro (FreeBSD: os-release ID, then freebsd)
python3 scripts/install_deps.py "$MODEL"
