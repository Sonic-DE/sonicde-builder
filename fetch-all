#!/usr/bin/env bash
# SPDX-License-Identifier: CC0-1.0
# run-fetch - fetch all active repositories
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# Generate model first
python3 scripts/config.py -root . \
    -solution config/sonicde/solutions/sonicde.yaml \
    -out state/model.json \
    "$@"

# Fetch
python3 scripts/fetch.py -model state/model.json "$@"
