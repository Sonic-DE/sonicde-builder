#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
# version-bump-frameworks - Update and commit Frameworks CMake versions, without tagging.
#
# Frameworks repos use set(KF_VERSION "X.Y.Z") in CMakeLists.txt.
# The new version (X.Y.Z) is the optional first argument; by default it is
# frameworks' tag in config/sync-upstream-tags without its v prefix.
#
# Unlike KDE's release scripts, no second "bump to next dev version" commit
# is created.  We make patch releases against these tagged versions.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
exec python3 "$SCRIPT_DIR/scripts/version_bump.py" frameworks "$@"
