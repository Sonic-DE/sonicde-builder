#!/usr/bin/env bash
# SPDX-License-Identifier: CC0-1.0
# autopick - run upstream sync autopick for all managed repos
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# Generate model
python3 scripts/config.py -root . \
    -solution config/sonicde/solutions/sonicde.yaml \
    -out state/model.json \
    "$@"

# Generate repo-list from model
python3 scripts/repositories.py -model state/model.json --view repo-list --out repo-list

REPOS=$(cat repo-list)
SCRIPT_DIR_ABS="$(pwd)/scripts"

FAILED_FILE="$(pwd)/state/failed-autopick-repos.txt"
mkdir -p state
> "$FAILED_FILE"

for i in $REPOS ; do
    dir="src/sonicde/$i"
    [ -d "$dir/.git" ] || { echo "[$i] checkout missing, skipping"; continue; }
    if ! ( cd "$dir" && "$SCRIPT_DIR_ABS/git-autopick" ); then
        echo "$i" >> "$FAILED_FILE"
    fi
done

if [ -s "$FAILED_FILE" ]; then
    echo ""
    echo "Failed repos:"
    cat "$FAILED_FILE"
    exit 1
fi
