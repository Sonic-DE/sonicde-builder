#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-only
# generate-depgraph - generate dependency graph (DOT + JSON)
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# Generate model
python3 scripts/config.py -root . \
    -solution config/sonicde/solutions/sonicde.yaml \
    -out state/model.json \
    "$@"

# Generate DOT
python3 scripts/generate.py -model state/model.json \
    --cmake-out /dev/null --dot-out depgraph.dot

echo "Dependency graph: depgraph.dot"
echo "Model: state/model.json"
